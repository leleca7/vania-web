# Overrides opcionais. A produção atual já tem fallback público para o Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VANIA_OWNER_ID=

# Vercel AI Gateway usa VERCEL_OIDC_TOKEN automaticamente em deploys compatíveis.
# Uma chave explícita do AI Gateway é opcional.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.6-sol

# O modo atual não usa SUPABASE_SERVICE_ROLE_KEY nem CRON_SECRET.
